# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set in Hostinger/env or .env.local (never commit .env.local with real values).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (optional).
APP_URL="MY_APP_URL"

# Client portal — Google Sign-In (kunde login at /login/kunde)
# CLIENT_GOOGLE_CLIENT_ID=
# CLIENT_GOOGLE_CLIENT_SECRET=
# Optional override; default is APP_URL + /api/client/auth/google/callback
# CLIENT_GOOGLE_REDIRECT_URI=https://asoldi.com/api/client/auth/google/callback
# Set to 0 when real Google OAuth is configured (default 1 = dev stub for Facebook)
# CLIENT_SOCIAL_DEV_MODE=0

# Optional persistent runtime storage path.
# On Hostinger the app defaults to .builds/data so runtime users/sites/admin data
# survive redeploys. Override only if you want a custom location.
# APP_DATA_DIR=

# Admin CMS (domain.com/admin). Change in production.
# ADMIN_USERNAME=asoldi.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_SECRET=long-random-string-for-jwt-signing

# For local dev with Vite: run API on port 3001 so Vite can proxy /api.
# PORT=3001

# Firebase: copy firebase-applet-config.example.json to firebase-applet-config.json
# and fill in values from Firebase Console. Do not commit real API keys.

# SMTP for password reset, booking emails (Hostinger or Resend).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=kontakt@asoldi.com
# SMTP_PASS=
# SMTP_FROM=Asoldi <kontakt@asoldi.com>
# SMTP_REPLY_TO=daracha777@gmail.com
# Optional fallback SMTP (used only when primary SMTP send fails).
# SMTP_FALLBACK_HOST=smtp.gmail.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USER=daracha777@gmail.com
# SMTP_FALLBACK_PASS=
# SMTP_FALLBACK_FROM=Asoldi <daracha777@gmail.com>
# SMTP_FALLBACK_REPLY_TO=kontakt@asoldi.com

# Sales/booking inbox routing.
# Primary recipient for website booking inquiries.
# BOOKING_INBOX_EMAIL=kontakt@asoldi.com
# Optional reply-to for booking submissions.
# BOOKING_REPLY_TO=daracha777@gmail.com
# Contact shown in Website Maker sales-intake metadata (salesContact).
# SALES_CONTACT_EMAIL=kontakt@asoldi.com

# Employee dashboard integrations.
# WordPress sync (imports employee users with employee/ansatt role).
# WORDPRESS_URL=https://asoldi.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# MyPhoner sync (campaign/list IDs can be comma-separated).
# MYPHONER_API_KEY=
# MYPHONER_SUBDOMAIN=
# MYPHONER_CAMPAIGN_ID=
# Incoming webhook secret (separate from API key). Required for winner auto-intake.
# MYPHONER_WEBHOOK_SECRET=
# Public base URL used when auto-registering webhook targets.
# Defaults to APP_URL when omitted.
# MYPHONER_WEBHOOK_BASE_URL=
# Enable/disable automatic webhook reconciliation loop (default 1).
# MYPHONER_WEBHOOK_RECONCILE_ENABLED=1
# How often to reconcile list/account webhooks (milliseconds, default 600000 = 10 min).
# MYPHONER_WEBHOOK_RECONCILE_MS=600000
# Replay window for duplicate webhook deliveries (milliseconds, default 120000 = 2 min).
# MYPHONER_WEBHOOK_REPLAY_WINDOW_MS=120000
# Owner key used when Myphoner creates new Sales clients automatically.
# MYPHONER_DEFAULT_SALES_OWNER_KEY=admin:daracha777@gmail.com
# Enable automatic post-winner enrichment of missing Sales links
# (google business/proff from metadata+internal rules, instagram/facebook via SerpAPI fallback).
# MYPHONER_AUTO_LINK_ENRICH=1
# Timeout per outbound search request in milliseconds (default 6000).
# MYPHONER_AUTO_LINK_ENRICH_TIMEOUT_MS=6000
# Cache TTL for repeated search queries in milliseconds (default 21600000 = 6h).
# MYPHONER_AUTO_LINK_SEARCH_CACHE_MS=21600000
# SerpAPI key used for social profile discovery (Instagram/Facebook only).
# Keep server-side only; never expose in client code.
# SERPAPI_API_KEY=
# Optional SerpAPI engine override (default google).
# SERPAPI_ENGINE=google
# Optional SerpAPI request timeout in milliseconds (default follows MYPHONER_AUTO_LINK_ENRICH_TIMEOUT_MS).
# SERPAPI_TIMEOUT_MS=6000
# Optional locale hints for Google results (for Norway, use no/no).
# SERPAPI_HL=no
# SERPAPI_GL=no
# Strict confidence controls for social link auto-save.
# Higher values reduce false positives (more links will be skipped).
# MYPHONER_SOCIAL_CONFIDENCE_MIN_SCORE=6
# MYPHONER_SOCIAL_CONFIDENCE_MIN_MARGIN=2
# MYPHONER_SOCIAL_CONFIDENCE_MIN_TOKEN_MATCHES=2

# Luca Regnskap sync.
# LUCA_API_KEY=
# LUCA_COMPANY_ID=
